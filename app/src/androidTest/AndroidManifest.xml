<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <application>
        <activity android:name="com.baba.callvault.dialer.TestPhoneHarnessActivity"
            android:exported="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Test APK only. No network, microphone, cellular, or production call-provider component. -->
        <service android:name="com.baba.callvault.dialer.TestPhoneConnectionService"
            android:exported="true" android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter><action android:name="android.telecom.ConnectionService" /></intent-filter>
        </service>
    </application>
</manifest>
